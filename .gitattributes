# Keep line endings stable no matter who commits (Windows autocrlf is the usual
# reason a .sh file works locally but fails after a push/pull: "bad interpreter: bash\r").
* text=auto
*.sh   text eol=lf
*.lua  text eol=lf
*.md   text eol=lf
*.bat  text eol=crlf

# Binary assets: never touch.
*.ttf  binary
*.png  binary
*.ogg  binary
*.ogv  binary
*.love binary
